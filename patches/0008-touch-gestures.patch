+void CTouchInput::LoadConfig()
+{
+	if (m_ConfigLoaded)
+		return;
+	m_ConfigLoaded = true;
+
+	// One finger draws a selection rectangle and two fingers move the world,
+	// which is the way round an RTS wants: selecting happens far more often
+	// than scrolling. Set touch.onefingerpan for the reverse.
+	m_OneFingerPan = g_ConfigDB.Get("touch.onefingerpan", m_OneFingerPan);
+	// 16px was about a millimetre on a phone screen, far inside a finger's own
+	// wobble, so nearly every tap turned into a drag.
+	m_DragThreshold = g_ConfigDB.Get("touch.dragthreshold", m_DragThreshold);
+	m_ZoomMin = g_ConfigDB.Get("view.zoom.min", m_ZoomMin);
+	m_ZoomMax = g_ConfigDB.Get("view.zoom.max", m_ZoomMax);
+}
+
+int CTouchInput::SlotForFinger(SDL_FingerID id, bool create)
+{
+	for (size_t i = 0; i < MAX_FINGERS; ++i)
+		if (m_Down[i] && m_FingerId[i] == id)
+			return static_cast<int>(i);
+
+	if (!create)
+		return -1;
+
+	for (size_t i = 0; i < MAX_FINGERS; ++i)
+		if (!m_Down[i])
+		{
+			m_Down[i] = true;
+			m_FingerId[i] = id;
+			return static_cast<int>(i);
+		}
+
+	// More fingers than we track; ignore the extra ones rather than scribble
+	// past the end of the arrays, which is what the prototype did.
+	return -1;
+}
+
+void CTouchInput::ReleaseSlot(int slot)
+{
+	if (slot >= 0 && static_cast<size_t>(slot) < MAX_FINGERS)
+		m_Down[slot] = false;
+}
+
+size_t CTouchInput::FingersDown() const
+{
+	size_t n = 0;
+	for (size_t i = 0; i < MAX_FINGERS; ++i)
+		if (m_Down[i])
+			++n;
+	return n;
+}
+
+bool CTouchInput::HasCamera() const
+{
+	// In the main menu there is no game and therefore no camera; the prototype
+	// dereferenced g_Game unconditionally and crashed on the first drag.
+	return g_Game && g_Game->GetView() && g_Game->GetView()->GetCamera();
+}
+
+void CTouchInput::BeginCameraGesture()
+{
+	if (!HasCamera())
+		return;
+
+	// Take the camera over from its controller before moving it. The
+	// controller's smoothed values are the authority, and they can differ from
+	// what is on screen - a minimap click sets them with SetValueSmoothly - so
+	// snap them onto the visible camera first. Everything after this builds on
+	// what the player actually sees.
+	CGameView* view = g_Game->GetView();
+	const CVector3D rot = view->GetCameraRotation();
+	view->SetCamera(view->GetCamera()->GetOrientation().GetTranslation(),
+		rot.X, rot.Y, view->GetCameraZoom());
+}
+
+void CTouchInput::MoveCameraBy(const CVector3D& delta)
+{
+	if (!HasCamera())
+		return;
+
+	// SetCamera writes the smoothed values with SetValue (target and current
+	// at once) and rebuilds the matrix without smoothing, so the move is
+	// immediate and survives the next CameraController::Update.
+	CGameView* view = g_Game->GetView();
+	const CVector3D rot = view->GetCameraRotation();
+	view->SetCamera(view->GetCameraPosition() + delta, rot.X, rot.Y,
+		view->GetCameraZoom());
+}
+
+void CTouchInput::BeginPan(float x, float y)
+{
+	if (!HasCamera())
+		return;
+
+	BeginCameraGesture();
+	const CCamera& camera = *(g_Game->GetView()->GetCamera());
+	m_PanFocus = camera.GetWorldCoordinates(x, y, true);
+}
+
+void CTouchInput::PanFocusTo(float x, float y)
+{
+	if (!HasCamera())
+		return;
+
+	const CCamera& camera = *(g_Game->GetView()->GetCamera());
+	auto [origin, dir] = camera.BuildCameraRay(x, y);
+	if (fabsf(dir.Y) < 1e-6f)
+		return;
+
+	// The height to travel is measured against the camera as it stands now,
+	// every single time: SetCamera runs FocusHeight, which nudges the camera
+	// height over uneven ground, and a distance cached at gesture start would
+	// let the world slide out from under the finger.
+	dir *= (m_PanFocus.Y - origin.Y) / dir.Y;
+	MoveCameraBy(m_PanFocus - dir - origin);
+}
