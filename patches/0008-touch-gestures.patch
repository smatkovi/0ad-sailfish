+/*
+ * Synthetic mouse events must bypass SDL's queue: in_poll_event turns
+ * everything that comes out of SDL_PollEvent (DisplayRotation), and these
+ * already carry logical coordinates. They also have to be fully initialised -
+ * GuiScriptConversions.cpp hands .clicks to the GUI scripts, and an
+ * uninitialised one made every tap do nothing at all.
+ */
+void CTouchInput::EmitMouseEvent(uint32_t type, uint8_t button, int x, int y,
+	uint8_t clicks)
+{
+	SDL_Event_ ev;
+	memset(&ev, 0, sizeof(ev));
+	ev.ev.type = type;
+	ev.ev.button.which = 0;
+	ev.ev.button.button = button;
+	ev.ev.button.clicks = clicks;
+	ev.ev.button.x = x;
+	ev.ev.button.y = y;
+	ev.ev.button.state = (type == SDL_MOUSEBUTTONDOWN) ? SDL_PRESSED : SDL_RELEASED;
+	in_push_priority_event(&ev);
+}
+
+void CTouchInput::EmitMotion(int x, int y, uint32_t buttonState)
+{
+	SDL_Event_ ev;
+	memset(&ev, 0, sizeof(ev));
+	ev.ev.type = SDL_MOUSEMOTION;
+	ev.ev.motion.which = 0;
+	ev.ev.motion.x = x;
+	ev.ev.motion.y = y;
+	ev.ev.motion.state = buttonState;
+	in_push_priority_event(&ev);
+}
+
+void CTouchInput::EmitClick(uint8_t button, int x, int y, uint8_t clicks)
+{
+	// The move has to come first: g_mouse_x/y, which the world uses to work
+	// out what was clicked, is only updated on motion.
+	EmitMotion(x, y, 0);
+	EmitMouseEvent(SDL_MOUSEBUTTONDOWN, button, x, y, clicks);
+	EmitMouseEvent(SDL_MOUSEBUTTONUP, button, x, y, clicks);
+}
